{
  "name": "wuxia-server",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.8"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env.local src/index.ts",
    "start": "node --env-file-if-exists=.env.local src/index.ts",
    "migrate": "node --env-file-if-exists=.env.local src/migrate.ts",
    "check": "tsc --noEmit",
    "test:story": "npm run test:game",
    "test:game": "node --test tests/onlineGame.test.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.0",
    "@fastify/rate-limit": "^10.0.0",
    "@fastify/websocket": "^11.0.0",
    "fastify": "^5.0.0",
    "pg": "^8.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.0.0",
    "@types/ws": "^8.0.0",
    "typescript": "~5.9.0"
  }
}
